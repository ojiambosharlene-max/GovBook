{
  "name": "government-appointment-system",
  "version": "1.0.0",
  "private": true,
  "description": "Digital Government Appointment Management System",
  "scripts": {
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev --prefix server\" \"npm run dev --prefix client\"",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "start": "npm start --prefix server",
    "db:setup": "npm run db:setup --prefix server",
    "db:reset": "npm run db:reset --prefix server",
    "test": "npm test --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

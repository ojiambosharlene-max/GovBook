NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# MySQL connection (the same login you use in MySQL Workbench)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=government_appointment_system

# Generate a long random value:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
BCRYPT_ROUNDS=10

# Citizens cannot book a slot that starts in less than this many minutes
BOOKING_LEAD_MINUTES=30
